@model List<WebApplication1.Models.Categoria>

@{
    ViewBag.Title = "Categorias";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";

    var totalCategorias = Model != null ? Model.Count : 0;
}

<div class="hero_general">
    <div class="bg-box">
        <img src="~/StaticFiles/images/navGeneral.jpg" />
    </div>
</div>

<style>
    .category-section {
        padding: 30px 0 40px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .category-container {
        max-width: 1250px;
        margin: 0 auto;
        padding: 0 16px;
    }

    .category-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .category-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #111827;
    }

    .category-subtitle {
        margin: 5px 0 0;
        font-size: 14px;
        color: #6b7280;
    }

    .category-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-category-primary {
        background: #111827;
        border: none;
        color: #fff;
        font-weight: 600;
        padding: 10px 16px;
        border-radius: 999px;
        text-decoration: none;
    }

        .btn-category-primary:hover {
            background: #000;
            color: #fff;
        }

    .btn-category-secondary {
        background: #16a34a;
        border: none;
        color: #fff;
        font-weight: 600;
        padding: 10px 16px;
        border-radius: 999px;
        text-decoration: none;
    }

        .btn-category-secondary:hover {
            background: #15803d;
            color: #fff;
        }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .dashboard-card {
        background: #fff;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        position: relative;
        overflow: hidden;
    }

        .dashboard-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: #2563eb;
        }

    .dashboard-label {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .dashboard-value {
        font-size: 30px;
        font-weight: 700;
        color: #111827;
        line-height: 1.1;
    }

    .dashboard-extra {
        margin-top: 8px;
        font-size: 13px;
        color: #9ca3af;
    }

    .category-alert {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 20px;
        font-weight: 600;
    }

        .category-alert.alert-error {
            background: #fee2e2;
            color: #991b1b;
            border-color: #fca5a5;
        }

    .category-filtros {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }

        .category-filtros input {
            border-radius: 999px;
            border: 1px solid #d1d5db;
            padding: 8px 14px;
            font-size: 14px;
            background: #fff;
            min-width: 260px;
        }

    .category-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        padding: 18px;
    }

    .category-card-title {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 14px;
    }

    table.dataTable thead th {
        background: #111827;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        border-bottom: none;
    }

    table.dataTable tbody td {
        vertical-align: middle;
        font-size: 14px;
    }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 15px;
        text-align: center;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            background: #f3f4f6 !important;
            border: none !important;
            border-radius: 999px !important;
            padding: 6px 14px !important;
            margin: 0 4px;
            font-size: 14px;
            font-weight: 600;
            color: #111827 !important;
            cursor: pointer !important;
            transition: all 0.2s ease-in-out;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background: #111827 !important;
                color: #fff !important;
                transform: translateY(-1px);
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background: #facc15 !important;
                color: #111827 !important;
                font-weight: 700;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
                background: #e5e7eb !important;
                color: #9ca3af !important;
                cursor: not-allowed !important;
            }

    .actions-cell {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-action-table {
        min-width: 90px;
        height: 36px;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        padding: 0 14px;
        color: #fff;
    }

        .btn-action-table:hover {
            transform: translateY(-1px);
            color: #fff;
            text-decoration: none;
        }

    .btn-action-edit {
        background: #f59e0b;
    }

        .btn-action-edit:hover {
            background: #d97706;
        }

    .btn-action-delete {
        background: #dc2626;
    }

        .btn-action-delete:hover {
            background: #b91c1c;
        }

    @@media (max-width: 992px) {
        .dashboard-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .category-head {
            flex-direction: column;
            align-items: flex-start;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .category-card {
            padding: 12px;
        }
    }
</style>

<section class="category-section">
    <div class="category-container">

        <div class="category-head">
            <div>
                <h2 class="category-title">Categorías</h2>
                <p class="category-subtitle">
                    Visualiza y administra las categorías de productos registradas en el sistema.
                </p>
            </div>

            <div class="category-actions">
                <a href="@Url.Action("AgregarCategoria", "Categoria")" class="btn btn-category-primary">
                    Agregar categoría
                </a>

                <a href="@Url.Action("VerInventario", "Inventario")" class="btn btn-category-secondary">
                    Ver lista de productos
                </a>
            </div>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            var tipo = (TempData["TipoMensaje"] as string ?? "").ToLower();

            <div class="category-alert @(tipo == "error" ? "alert-error" : "")">
                @TempData["Mensaje"]
            </div>
        }

        <div class="dashboard-grid">
            <div class="dashboard-card">
                <div class="dashboard-label">Total de categorías</div>
                <div class="dashboard-value">@totalCategorias</div>
                <div class="dashboard-extra">Categorías registradas en el sistema</div>
            </div>
        </div>

        <div class="category-filtros">
            <input type="text" id="filtroBusquedaCategoria" placeholder="Buscar nombre o descripción..." />
        </div>

        <div class="category-card">
            <h3 class="category-card-title">Listado de categorías</h3>

            <div class="table-responsive" style="overflow: visible;">
                <table id="tablaCategorias" class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th style="width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var categoria in Model)
                            {
                                <tr>
                                    <td>@categoria.Nombre</td>
                                    <td>@categoria.Descripcion</td>
                                    <td>
                                        <div class="actions-cell">
                                            <a href="@Url.Action("ActualizarCategoria", "Categoria", new { id = categoria.CategoriaID })"
                                               class="btn-action-table btn-action-edit">
                                                Editar
                                            </a>

                                            @using (Html.BeginForm("EliminarCategoria", "Categoria", FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", categoria.CategoriaID)

                                                <button type="submit"
                                                        class="btn-action-table btn-action-delete"
                                                        onclick="return confirm('¿Seguro que deseas eliminar esta categoría?')">
                                                    Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {

            if (!$('#tablaCategorias').length) {
                return;
            }

            if ($.fn.DataTable.isDataTable('#tablaCategorias')) {
                return;
            }

            var table = $('#tablaCategorias').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json',
                    paginate: {
                        previous: "← Anterior",
                        next: "Siguiente →"
                    }
                },
                pageLength: 5,
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [2] }
                ],
                dom: 't<"bottom"ip>'
            });

            $('#filtroBusquedaCategoria').on('keyup', function () {
                table.search(this.value).draw();
            });
        });
    </script>
}
