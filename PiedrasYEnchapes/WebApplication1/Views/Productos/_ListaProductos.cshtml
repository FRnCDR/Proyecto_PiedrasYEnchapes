@model List<WebApplication1.Models.Producto>
@using System.Collections.Generic

@*
    Resultados del catálogo (tarjetas + paginación).
    Se renderiza dentro de VerProductos y también solo, como respuesta AJAX,
    cuando el usuario escribe en el buscador.
*@

@{
    var terminoBusqueda = ViewBag.Buscar as string;
    var paginaActual = ViewBag.PaginaActual != null ? (int)ViewBag.PaginaActual : 1;
    var totalPaginas = ViewBag.TotalPaginas != null ? (int)ViewBag.TotalPaginas : 0;
}

<div class="filters-content">
    <div class="row grid">

        @if (Model != null && Model.Any())
        {
            var contador = 1;

            foreach (var item in Model)
            {
                var numero = contador.ToString("D2");
                var rutaImagen = !string.IsNullOrEmpty(item.Imagen)
                    ? Url.Content("~/StaticFiles/images/" + item.Imagen)
                    : Url.Content("~/StaticFiles/images/no-image.png");

                <div class="col-sm-6 col-lg-4 all producto-item">
                    <article class="catalog-card">
                        <a class="catalog-img" href="@Url.Action("DetalleProducto", "Productos", new { id = item.ProductoID })">
                            <img src="@rutaImagen" alt="@item.Nombre" />
                        </a>

                        <div class="catalog-body">
                            <div class="catalog-topline">
                                <span class="catalog-num">@numero</span>
                                <div class="catalog-meta">
                                    <h5 class="catalog-name">@item.Nombre</h5>
                                    @if (!item.Estado)
                                    {
                                        <p class="out-of-stock">Sin stock</p>
                                    }
                                    <p class="catalog-desc">@item.Descripcion</p>
                                </div>
                            </div>

                            <div class="catalog-bottom">
                                <span class="catalog-price">₡@item.Precio</span>
                                <a class="catalog-link" href="@Url.Action("DetalleProducto", "Productos", new { id = item.ProductoID })">
                                    Ver detalle <span class="arrow">→</span>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>

                contador++;
            }
        }
        else if (!string.IsNullOrEmpty(terminoBusqueda))
        {
            <div class="col-12">
                <div class="alert alert-info text-center">
                    No se encontraron productos que coincidan con "@terminoBusqueda".
                </div>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center">
                    No hay productos disponibles en este momento.
                </div>
            </div>
        }

    </div>
</div>

@if (totalPaginas > 1)
{
    var paginasAMostrar = new List<int?>();
    var rangoInicio = Math.Max(1, paginaActual - 2);
    var rangoFin = Math.Min(totalPaginas, paginaActual + 2);

    if (rangoInicio > 1)
    {
        paginasAMostrar.Add(1);
        if (rangoInicio > 2) { paginasAMostrar.Add(null); }
    }

    for (var i = rangoInicio; i <= rangoFin; i++)
    {
        paginasAMostrar.Add(i);
    }

    if (rangoFin < totalPaginas)
    {
        if (rangoFin < totalPaginas - 1) { paginasAMostrar.Add(null); }
        paginasAMostrar.Add(totalPaginas);
    }

    <nav class="catalog-pagination" aria-label="Paginación de productos">
        @if (paginaActual > 1)
        {
            <a class="page-btn page-nav" href="@Url.Action("VerProductos", new { pagina = paginaActual - 1, buscar = terminoBusqueda })">← Anterior</a>
        }

        @foreach (var p in paginasAMostrar)
        {
            if (p == null)
            {
                <span class="page-ellipsis">…</span>
            }
            else if (p == paginaActual)
            {
                <span class="page-btn current">@p</span>
            }
            else
            {
                <a class="page-btn" href="@Url.Action("VerProductos", new { pagina = p, buscar = terminoBusqueda })">@p</a>
            }
        }

        @if (paginaActual < totalPaginas)
        {
            <a class="page-btn page-nav" href="@Url.Action("VerProductos", new { pagina = paginaActual + 1, buscar = terminoBusqueda })">Siguiente →</a>
        }
    </nav>
}
