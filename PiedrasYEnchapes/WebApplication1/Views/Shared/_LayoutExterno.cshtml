@* Views/Shared/_LayoutExterno.cshtml *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Piedras Decorativas</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    @* Icono de la pestaña: monograma GF de la marca *@
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/StaticFiles/images/favicon-gf-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/StaticFiles/images/favicon-gf-180.png" />

    <link rel="stylesheet" href="~/StaticFiles/css/bootstrap.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

    <!-- Estilos generales -->
    <link rel="stylesheet" href="~/StaticFiles/css/style.css" />
    <link rel="stylesheet" href="~/StaticFiles/css/responsive.css" />
    <link rel="stylesheet" href="~/StaticFiles/css/login.css" />
    <link href="~/StaticFiles/css/toast.css" rel="stylesheet" />



</head>
<body style="background:#f5f5f5;">

    @RenderBody()

    <!-- JS -->
    <script src="~/StaticFiles/js/jquery-3.4.1.min.js"></script>
    <script src="~/StaticFiles/js/bootstrap.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
