@model WebApplication1.Models.Cotizacion

@{
    ViewBag.Title = "Nueva Cotización";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div class="hero_general">
    <div class="bg-box">
        <img src="~/StaticFiles/images/navGeneral.jpg" />
    </div>
</div>

<style>
    .cotizacion-section {
        padding: 30px 0 50px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .cotizacion-container {
        max-width: 700px;
        margin: auto;
        padding: 0 16px;
    }

    .cotizacion-header {
        margin-bottom: 24px;
    }

    .cotizacion-title {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .cotizacion-subtitle {
        color: #6b7280;
        font-size: 14px;
    }

    .cotizacion-card {
        background: #fff;
        border-radius: 14px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 6px;
        display: block;
        color: #374151;
    }

        .form-label span {
            color: #9ca3af;
            font-weight: 400;
        }

    .form-control {
        border-radius: 8px;
        border: 1px solid #d1d5db;
        padding: 9px 12px;
        width: 100%;
        font-size: 14px;
        transition: border-color 0.2s;
    }

        .form-control:focus {
            border-color: #111827;
            outline: none;
            box-shadow: 0 0 0 3px rgba(17,24,39,0.08);
        }

    .info-box-usuario {
        background: #f3f4f6;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 14px;
        color: #374151;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .info-box-usuario strong {
            color: #111827;
        }

    .acciones {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-primary-custom {
        background: #111827;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-primary-custom:hover {
            background: #000;
        }

    .btn-secondary-custom {
        background: #e5e7eb;
        color: #374151;
        border: none;
        padding: 10px 20px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s;
    }

        .btn-secondary-custom:hover {
            background: #d1d5db;
            color: #111827;
            text-decoration: none;
        }

    .alert-error-custom {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fca5a5;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }
</style>

<section class="cotizacion-section">
    <div class="cotizacion-container">

        <div class="cotizacion-header">
            <h2 class="cotizacion-title">Nueva Cotización</h2>
            <p class="cotizacion-subtitle">
                Se creará una cotización a tu nombre. Luego podrás agregar los productos que necesitas.
            </p>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert-error-custom">@ViewBag.Mensaje</div>
        }

        <div class="cotizacion-card">

            <div class="info-box-usuario">
                <span>👤</span>
                <span>Cotización para: <strong>@Session["Nombre"]</strong></span>
            </div>

            @using (Html.BeginForm("CrearCotizacion", "Cotizacion", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">
                        Observaciones <span>(opcional)</span>
                    </label>
                    @Html.TextAreaFor(
                        m => m.Observaciones,
                        new
                        {
                            @class = "form-control",
                            rows = 4,
                            placeholder = "Escribe aquí cualquier detalle adicional para esta cotización..."
                        }
                    )
                </div>

                <div class="acciones">
                    <button type="submit" class="btn-primary-custom">
                        Crear Cotización
                    </button>
                    <a href="@Url.Action("VerCotizaciones", "Cotizacion")"
                       class="btn-secondary-custom">
                        Cancelar
                    </a>
                </div>
            }

        </div>

    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}