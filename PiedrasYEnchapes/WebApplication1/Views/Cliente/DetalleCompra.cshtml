@model List<WebApplication1.Models.DetalleCompraModel>

@{
    ViewBag.Title = "Detalle de Compra";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";

    var total = Model != null ? Model.Sum(x => x.Subtotal) : 0;

    // Número de WhatsApp de la empresa (configurable en Web.config).
    var whatsappNumero = System.Configuration.ConfigurationManager.AppSettings["WhatsAppEmpresa"];

    // Mensaje pre-armado con el detalle de esta compra para coordinar por WhatsApp.
    var sbMensaje = new System.Text.StringBuilder();
    sbMensaje.Append("Hola, quiero coordinar mi compra #" + ViewBag.CompraID + " de Piedras y Enchapes.\n\n");
    if (Model != null)
    {
        foreach (var item in Model)
        {
            sbMensaje.Append("• " + item.Cantidad + " x " + item.NombreProducto
                             + " — ₡" + item.Subtotal.ToString("N2") + "\n");
        }
    }
    sbMensaje.Append("\nTotal: ₡" + total.ToString("N2"));

    var whatsappUrl = "https://wa.me/" + whatsappNumero + "?text=" + Uri.EscapeDataString(sbMensaje.ToString());
}

<div class="hero_general">
    <div class="bg-box">
        <img src="~/StaticFiles/images/navGeneral.jpg" />
    </div>
</div>

<style>
    .detalle-section {
        padding: 30px 0 40px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .detalle-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 16px;
    }

    .detalle-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        padding: 18px;
    }

    .detalle-title {
        font-size: 26px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 8px;
    }

    .detalle-subtitle {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 20px;
    }

    table thead th {
        background: #111827;
        color: #fff;
    }

    .btn-volver {
        display: inline-flex;
        align-items: center;
        background: #111827;
        color: #fff;
        padding: 10px 16px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-volver:hover {
            background: #000;
            color: #fff;
            text-decoration: none;
        }

    .alert-detalle {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
        border-radius: 12px;
        padding: 14px 16px;
        font-weight: 600;
    }

    .detalle-acciones {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
        align-items: center;
    }

    .btn-whatsapp {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #25d366;
        color: #fff;
        padding: 10px 18px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
    }

        .btn-whatsapp:hover {
            background: #1da851;
            color: #fff;
            text-decoration: none;
        }

    .whatsapp-nota {
        margin-top: 12px;
        font-size: 13px;
        color: #6b7280;
    }
</style>

<section class="detalle-section">
    <div class="detalle-container">

        <div class="detalle-acciones">
            <a href="@Url.Action("HistorialCompras", "Cliente")" class="btn-volver">
                Volver al historial
            </a>

            @if (Model != null && Model.Any())
            {
                <a href="@whatsappUrl" target="_blank" rel="noopener" class="btn-whatsapp">
                    <i class="fa fa-whatsapp"></i>
                    Coordinar compra por WhatsApp
                </a>
            }
        </div>

        <div class="detalle-card">
            <h2 class="detalle-title">Detalle de Compra #@ViewBag.CompraID</h2>
            <p class="detalle-subtitle">
                Este comprobante es tu registro de compra. Para concretar el pago y la entrega,
                coordina con la empresa por WhatsApp usando el botón de arriba.
            </p>

            @if (Model == null || !Model.Any())
            {
                <div class="alert-detalle">
                    No hay detalle disponible para esta compra.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NombreProducto</td>
                                    <td>@item.Cantidad</td>
                                    <td>₡ @item.PrecioUnitario.ToString("N2")</td>
                                    <td>₡ @item.Subtotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</section>