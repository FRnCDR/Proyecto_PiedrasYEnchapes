	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" maxRequestLength="10240" executionTimeout="300" />
		<!-- Seguridad de cookies: HttpOnly evita lectura por JavaScript (XSS) y SameSite mitiga CSRF -->
		<httpCookies httpOnlyCookies="true" sameSite="Strict" requireSSL="false" />
		<!-- Cookie de sesión de ASP.NET (ASP.NET_SessionId) con SameSite -->
		<sessionState cookieSameSite="Strict" />
	</system.web>
